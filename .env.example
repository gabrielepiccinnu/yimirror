# Copy to .env and fill in. NEVER commit .env (gitignored).

# --- Yi account (the owner's own account) ---
YI_USER=you@example.com
YI_PASS=your-password
YI_REGION=eu                # us | eu | cn | tw  -> api.{us,eu}.xiaoyi.com | api.xiaoyi.com(.tw)

# --- HMAC key for v5-style signed requests ("secretA&secretB" or single value) ---
# Recovered dynamically from the app (frida hook on d9.e.<init>); default fallback below
# is the in-code fallback key from ra/c1 (HmacSha1) and is only a placeholder.
YI_CLIENT_SECRET=04b1aa5fb31e185f

# --- Session token override (optional): if the login password cipher can't be
#     reproduced, seed a token captured from a logged-in app session ---
# YI_SESSION_TOKEN=

# --- Mirror behaviour ---
YIMIRROR_INTERVAL=1200      # seconds between cycles
YIMIRROR_LOOKBACK_DAYS=3    # re-check the last N days each cycle
YIMIRROR_KEEP_LOCAL=0       # 1 = keep local MP4s after upload, 0 = delete

# --- Backblaze B2 (env-based rclone remote, no config file) ---
B2_BUCKET=your-bucket-name
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=your-keyID
RCLONE_CONFIG_B2_KEY=your-applicationKey

# --- Bridge live (cattura della diretta) ---
# YIMIRROR_UPLOAD=http          # http | rclone | local
# YIMIRROR_INGEST_URL=https://ingest.tuo-dominio.tld
# YIMIRROR_INGEST_USER=bridge
# YIMIRROR_INGEST_PASS=password-lunga-casuale
# YIMIRROR_INGEST_TOKEN=token-lungo-casuale   # secondo fattore (header X-Ingest-Token)
# YIMIRROR_TNP_HOST=82.192.139.67
# YIMIRROR_RETENTION_DAYS=7

# --- Proxy autonomo: sessione TNP nativa (native_test.py, live.py --source native,
#     rtsp_push.py --source native — findings §7v/§7w) ---
# P2PID: il p2pid della camera ("<prefix>-<sn>-<checkcode>", es. TNPUSAQ-245460-SYUPE)
# LICENSE: la License di 6 caratteri dal /v4/tnp/device_info
# INIT_STRING: la InitString della camera (96 char, dal db dell'app device_info.tnpServerString)
# P2P_PASSWORD: la viewPassword dal db dell'app (device_info.viewPassword,
#   ruota a ogni refresh device list — aggiornarla se il relay risponde ffff)
# YIMIRROR_P2PID=
# YIMIRROR_LICENSE=
# YIMIRROR_INIT_STRING=
# YIMIRROR_P2P_PASSWORD=

# --- Deploy Dokploy (server di storage) ---
# YIMIRROR_DOMAIN=ingest.tuo-dominio.tld
# YIMIRROR_BASICAUTH_USERS=bridge:$2y$05$...   # genera con deploy/htpasswd.sh
